{
  "name": "@crewbit/protocol",
  "version": "0.0.0",
  "description": "The JSON-RPC 2.0 wire protocol between the Crewbit server and a runner",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "docs"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crewbit-sh/protocol.git"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "node scripts/guard-placeholder-version.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "typescript": "^5.7.3",
    "vitest": "^4.1.11"
  }
}
